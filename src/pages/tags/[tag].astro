---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

export async function getStaticPaths() {
	const entries = await getCollection('pages');
	const tags = [...new Set(entries.flatMap((e) => e.data.tags))];

	return tags.map((tag) => ({
		params: { tag },
		props: {
			tag,
			entries: entries.filter((e) => e.data.tags.includes(tag)),
		},
	}));
}

const { tag, entries } = Astro.props;
const sortedEntries = entries.sort(
	(a: any, b: any) => b.data.uploaded_date.localeCompare(a.data.uploaded_date)
);
---

<BaseLayout title={`#${tag} — Becoming X`}>
	<div class="mb-6">
		<a href="/" class="mb-4 inline-block text-sm text-gray-500 hover:text-gray-700">
			&larr; Back to dashboard
		</a>
		<h1 class="text-2xl font-bold">
			<span class="text-gray-400">#</span>{tag}
		</h1>
		<p class="mt-1 text-sm text-gray-500">
			{sortedEntries.length} {sortedEntries.length === 1 ? 'post' : 'posts'}
		</p>
	</div>

	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{sortedEntries.map((entry: any) => (
			<ContentCard
				slug={entry.data.slug}
				title={entry.data.title}
				description={entry.data.description}
				tags={entry.data.tags}
				uploaded_date={entry.data.uploaded_date}
				created_date={entry.data.created_date}
				format={entry.data.format}
			/>
		))}
	</div>
</BaseLayout>
