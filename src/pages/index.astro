---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';

const entries = await getCollection('pages');
const allTags = [...new Set(entries.flatMap((e) => e.data.tags))].sort();
---

<BaseLayout title="Becoming X">
	<!-- Controls -->
	<div class="mb-6 space-y-4">
		<!-- Search -->
		<input
			id="search"
			type="text"
			placeholder="Search by title or description..."
			class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-gray-500 focus:outline-none"
		/>

		<!-- Tags -->
		{allTags.length > 0 && (
			<div id="tag-filters" class="flex flex-wrap gap-2">
				{allTags.map((tag) => (
					<button
						class="tag-btn rounded-full border border-gray-300 px-3 py-1 text-xs transition-colors hover:bg-gray-200"
						data-tag={tag}
					>
						{tag}
					</button>
				))}
			</div>
		)}

		<!-- Sort -->
		<div class="flex items-center gap-3">
			<label for="sort-select" class="text-sm text-gray-500">Sort by:</label>
			<select
				id="sort-select"
				class="rounded border border-gray-300 px-3 py-1.5 text-sm focus:border-gray-500 focus:outline-none"
			>
				<option value="uploaded-desc">Uploaded (newest)</option>
				<option value="uploaded-asc">Uploaded (oldest)</option>
				<option value="created-desc">Created (newest)</option>
				<option value="created-asc">Created (oldest)</option>
				<option value="title-asc">Title (A-Z)</option>
				<option value="title-desc">Title (Z-A)</option>
			</select>
		</div>
	</div>

	<!-- Card Grid -->
	<div id="card-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{entries.map((entry) => (
			<ContentCard
				slug={entry.data.slug}
				title={entry.data.title}
				description={entry.data.description}
				tags={entry.data.tags}
				uploaded_date={entry.data.uploaded_date}
				created_date={entry.data.created_date}
				format={entry.data.format}
			/>
		))}
	</div>

	<!-- Empty state -->
	<p id="no-results" class="mt-8 hidden text-center text-gray-400">No matching content found.</p>
</BaseLayout>

<script>
	const searchInput = document.getElementById('search') as HTMLInputElement;
	const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
	const grid = document.getElementById('card-grid')!;
	const noResults = document.getElementById('no-results')!;
	const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');

	const activeTags = new Set<string>();

	function getCards(): HTMLElement[] {
		return Array.from(grid.querySelectorAll<HTMLElement>('.content-card'));
	}

	function applyFilters() {
		const query = searchInput.value.toLowerCase().trim();
		const cards = getCards();
		let visibleCount = 0;

		for (const card of cards) {
			const title = card.dataset.title ?? '';
			const desc = card.dataset.description ?? '';
			const cardTags = (card.dataset.tags ?? '').split(',').filter(Boolean);

			const matchesSearch = !query || title.includes(query) || desc.includes(query);
			const matchesTags =
				activeTags.size === 0 || [...activeTags].every((t) => cardTags.includes(t));

			if (matchesSearch && matchesTags) {
				card.style.display = '';
				visibleCount++;
			} else {
				card.style.display = 'none';
			}
		}

		noResults.classList.toggle('hidden', visibleCount > 0);
	}

	function applySort() {
		const [field, dir] = sortSelect.value.split('-') as [string, string];
		const cards = getCards();

		cards.sort((a, b) => {
			let aVal: string, bVal: string;
			if (field === 'title') {
				aVal = a.dataset.title ?? '';
				bVal = b.dataset.title ?? '';
			} else if (field === 'uploaded') {
				aVal = a.dataset.uploaded ?? '';
				bVal = b.dataset.uploaded ?? '';
			} else {
				aVal = a.dataset.created ?? '';
				bVal = b.dataset.created ?? '';
			}
			const cmp = aVal.localeCompare(bVal);
			return dir === 'asc' ? cmp : -cmp;
		});

		for (const card of cards) {
			grid.appendChild(card);
		}
	}

	searchInput.addEventListener('input', applyFilters);

	sortSelect.addEventListener('change', () => {
		applySort();
		applyFilters();
	});

	tagButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const tag = btn.dataset.tag!;
			if (activeTags.has(tag)) {
				activeTags.delete(tag);
				btn.classList.remove('bg-gray-800', 'text-white', 'border-gray-800');
			} else {
				activeTags.add(tag);
				btn.classList.add('bg-gray-800', 'text-white', 'border-gray-800');
			}
			applyFilters();
		});
	});

	// Initial sort
	applySort();
</script>
