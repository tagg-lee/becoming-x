---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getContributor, getAllContributorNames } from '../../data/contributors';

export async function getStaticPaths() {
	const entries = await getCollection('pages');
	const contentContributors = entries.map((e) => e.data.contributor).filter(Boolean);
	const registeredContributors = getAllContributorNames();
	const allContributors = [...new Set([...contentContributors, ...registeredContributors])];

	return allContributors.map((contributor) => ({
		params: { contributor },
		props: {
			contributor,
			entries: entries.filter((e) => e.data.contributor === contributor),
		},
	}));
}

const { contributor, entries } = Astro.props;
const data = getContributor(contributor);
const sortedEntries = entries.sort(
	(a: any, b: any) => b.data.uploaded_date.localeCompare(a.data.uploaded_date)
);

const ICON_SVG: Record<string, string> = {
