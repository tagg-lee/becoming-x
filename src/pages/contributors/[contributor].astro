---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

export async function getStaticPaths() {
	const entries = await getCollection('pages');
	const contributors = [...new Set(entries.map((e) => e.data.contributor).filter(Boolean))];

	return contributors.map((contributor) => ({
		params: { contributor },
		props: {
			contributor,
			entries: entries.filter((e) => e.data.contributor === contributor),
		},
	}));
}

const { contributor, entries } = Astro.props;
const sortedEntries = entries.sort(
	(a: any, b: any) => b.data.uploaded_date.localeCompare(a.data.uploaded_date)
);
---

<BaseLayout title={`${contributor} — Becoming X`}>
	<div class="mb-6">
		<a href="/" class="mb-4 inline-block text-sm text-gray-500 hover:text-gray-700">
			&larr; Back to dashboard
		</a>
		<div class="mb-2 flex items-center gap-3">
			<div class="flex h-12 w-12 items-center justify-center rounded-full bg-purple-100 text-lg font-bold text-purple-700">
				{contributor.charAt(0)}
			</div>
			<div>
				<h1 class="text-2xl font-bold">{contributor}</h1>
				<p class="text-sm text-gray-500">Contributor</p>
			</div>
		</div>
		<p class="mt-2 text-sm text-gray-500">
			{sortedEntries.length} {sortedEntries.length === 1 ? 'contribution' : 'contributions'}
		</p>
	</div>

	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{sortedEntries.map((entry: any) => (
			<ContentCard
				slug={entry.data.slug}
				title={entry.data.title}
				description={entry.data.description}
				tags={entry.data.tags}
				uploaded_date={entry.data.uploaded_date}
				created_date={entry.data.created_date}
				format={entry.data.format}
				contributor={entry.data.contributor}
			/>
		))}
	</div>
</BaseLayout>
