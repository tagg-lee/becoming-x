};
---

<BaseLayout title={`${contributor} — Becoming X`}>
	<div class="mb-6">
		<a href="/" class="mb-4 inline-block text-sm text-gray-500 hover:text-gray-700">
			&larr; Back to dashboard
		</a>
		<div class="mb-2 flex items-center gap-3">
			{data?.avatar ? (
				<img
					src={data.avatar}
					alt={contributor}
					class="h-12 w-12 rounded-full object-cover"
				/>
			) : (
				<div class="flex h-12 w-12 items-center justify-center rounded-full bg-purple-100 text-lg font-bold text-purple-700">
					{contributor.charAt(0)}
				</div>
			)}
			<div>
				<h1 class="text-2xl font-bold">{contributor}</h1>
				<p class="text-sm text-gray-500">Contributor</p>
			</div>
		</div>
		{data && (
			<p class="mt-2 text-sm text-gray-600">{data.bio}</p>
		)}
		{data?.links && data.links.length > 0 && (
			<div class="mt-3 flex gap-2">
				{data.links.map((link) => (
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						class="contributor-profile-link"
						title={link.label || link.platform}
					>
						<Fragment set:html={ICON_SVG[link.platform] || ICON_SVG.website} />
					</a>
				))}
			</div>
		)}
		<p class="mt-3 text-sm text-gray-500">
			{sortedEntries.length} {sortedEntries.length === 1 ? 'contribution' : 'contributions'}
		</p>
	</div>

	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{sortedEntries.map((entry: any) => (
			<ContentCard
				slug={entry.data.slug}
				title={entry.data.title}
				description={entry.data.description}
				tags={entry.data.tags}
				uploaded_date={entry.data.uploaded_date}
				created_date={entry.data.created_date}
				format={entry.data.format}
				contributor={entry.data.contributor}
			/>
		))}
	</div>
</BaseLayout>

<style>
	.contributor-profile-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		background: #f6f8fa;
		color: #656d76;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.contributor-profile-link:hover {
		background: #7c3aed;
		color: #fff;
	}

	.contributor-profile-link :global(svg) {
		width: 18px;
		height: 18px;
	}
</style>
