---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContributor, getAllContributorNames } from '../../data/contributors';

const entries = await getCollection('pages');
const contributorNames = getAllContributorNames();

// Build contributor stats
const contributorStats = contributorNames.map((name) => {
	const data = getContributor(name)!;
	const contributions = entries.filter((e) => e.data.contributor === name);
	const latestDate = contributions.length > 0
		? contributions
			.map((e) => e.data.uploaded_date)
			.sort()
			.reverse()[0]
		: null;
	const tags = [...new Set(contributions.flatMap((e) => e.data.tags))];
	return { name, data, contributions, latestDate, tags };
});

// Sort by contribution count (desc), then name (asc)
contributorStats.sort((a, b) => b.contributions.length - a.contributions.length || a.name.localeCompare(b.name));

const totalContributions = entries.filter((e) => e.data.contributor).length;

const ICON_SVG: Record<string, string> = {
