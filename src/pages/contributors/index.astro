---

<BaseLayout title="Contributors — Becoming X">
	<div class="mb-6">
		<a href="/" class="mb-4 inline-block text-sm text-gray-500 hover:text-gray-700">
			&larr; Back to dashboard
		</a>
		<h1 class="text-2xl font-bold text-gray-900">Contributors</h1>
		<p class="mt-1 text-sm text-gray-500">
			{contributorNames.length} {contributorNames.length === 1 ? 'contributor' : 'contributors'} &middot; {totalContributions} {totalContributions === 1 ? 'contribution' : 'contributions'}
		</p>
	</div>

	<!-- Summary Stats -->
	<div class="mb-8 grid grid-cols-3 gap-4">
		<div class="rounded-lg border border-gray-200 bg-white p-4 text-center">
			<div class="text-2xl font-bold text-purple-700">{contributorNames.length}</div>
			<div class="mt-1 text-xs text-gray-500">Contributors</div>
		</div>
		<div class="rounded-lg border border-gray-200 bg-white p-4 text-center">
			<div class="text-2xl font-bold text-purple-700">{totalContributions}</div>
			<div class="mt-1 text-xs text-gray-500">Contributions</div>
		</div>
		<div class="rounded-lg border border-gray-200 bg-white p-4 text-center">
			<div class="text-2xl font-bold text-purple-700">
				{[...new Set(contributorStats.flatMap((c) => c.tags))].length}
			</div>
			<div class="mt-1 text-xs text-gray-500">Tags Covered</div>
		</div>
	</div>

	<!-- Contributor Cards -->
	<div class="space-y-4">
		{contributorStats.map((stat) => (
			<div
				data-href={`/contributors/${stat.name}`}
				class="contributor-card block cursor-pointer rounded-lg border border-gray-200 bg-white p-5 transition-all hover:border-purple-200 hover:shadow-md"
			>
				<div class="flex items-start gap-4">
					{/* Avatar */}
					{stat.data.avatar ? (
						<img
							src={stat.data.avatar}
							alt={stat.name}
							class="h-14 w-14 flex-shrink-0 rounded-full object-cover"
						/>
					) : (
						<div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-purple-100 text-xl font-bold text-purple-700">
							{stat.name.charAt(0)}
						</div>
					)}

					{/* Info */}
					<div class="min-w-0 flex-1">
						<div class="flex items-center gap-2">
							<h2 class="text-lg font-semibold text-gray-900">{stat.name}</h2>
							<span class="rounded-full bg-purple-50 px-2 py-0.5 text-xs font-medium text-purple-700">
								{stat.contributions.length} {stat.contributions.length === 1 ? 'contribution' : 'contributions'}
							</span>
						</div>
						<div class="mt-0.5 text-sm text-gray-500">
								{stat.data.bio.split('\n').map((line) => (
									<p>{line}</p>
								))}
							</div>

						{/* Social Links */}
						<div class="mt-3 flex gap-1.5">
							{stat.data.links.map((link) => (
								<a
									href={link.url}
									target="_blank"
									rel="noopener noreferrer"
									class="contributor-social-link"
									title={link.label || link.platform}
								>
									<Fragment set:html={ICON_SVG[link.platform] || ICON_SVG.website} />
								</a>
							))}
						</div>

						{/* Tags + Latest */}
						{stat.tags.length > 0 && (
							<div class="mt-3 flex flex-wrap gap-1.5">
								{stat.tags.slice(0, 6).map((tag) => (
									<span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">
										{tag}
									</span>
								))}
								{stat.tags.length > 6 && (
									<span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-400">
										+{stat.tags.length - 6}
									</span>
								)}
							</div>
						)}

						{stat.latestDate && (
							<p class="mt-2 text-xs text-gray-400">
								Latest: {stat.latestDate}
							</p>
						)}
					</div>
				</div>
			</div>
		))}
	</div>

	{/* Empty state */}
	{contributorNames.length === 0 && (
		<div class="mt-12 text-center">
			<p class="text-gray-400">No contributors yet.</p>
		</div>
	)}
</BaseLayout>

<style>
	.contributor-social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		border-radius: 6px;
		background: #f6f8fa;
		color: #656d76;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.contributor-social-link:hover {
		background: #7c3aed;
		color: #fff;
	}

	.contributor-social-link :global(svg) {
		width: 16px;
		height: 16px;
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.contributor-card').forEach((card) => {
		card.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) return;
			const href = card.dataset.href;
			if (href) window.location.href = href;
		});
	});
</script>
