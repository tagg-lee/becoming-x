---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { marked, extractHeadings, extractHeadingsFromHtml } from '../../lib/markdown';

export async function getStaticPaths() {
	const entries = await getCollection('pages');
	return entries.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { title, description, tags, uploaded_date, created_date, contributor, format, body, rendered_html } =
	entry.data;

const html = format === 'md' ? await marked(body) : rendered_html;
const headings = format === 'md' ? extractHeadings(body) : extractHeadingsFromHtml(html);
---

<ContentLayout
	title={title}
	description={description}
	tags={tags}
	uploaded_date={uploaded_date}
	created_date={created_date}
	contributor={contributor}
	headings={headings}
>
	<Fragment set:html={html} />
</ContentLayout>
