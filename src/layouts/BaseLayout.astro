---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Becoming X — Content Dashboard' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-gray-50 text-gray-900">
		<header class="border-b border-gray-200 bg-white">
			<div class="mx-auto max-w-6xl px-4 py-4">
				<a href="/" class="text-xl font-bold tracking-tight">Becoming X</a>
			</div>
		</header>
		<main class="mx-auto max-w-6xl px-4 py-8">
			<slot />
		</main>
		<footer class="mt-16 border-t border-gray-200 bg-white">
			<div class="mx-auto max-w-6xl px-4 py-6">
				<div class="flex flex-col items-center gap-2 text-sm text-gray-400">
					<p>&copy; {new Date().getFullYear()} Becoming X — Tagg Lee (이태극)</p>
					<p>
						<a href="mailto:overmensch280@gmail.com" class="hover:text-gray-600 transition-colors">overmensch280@gmail.com</a>
						<span class="mx-1">·</span>
						<a href="https://class.cmdspace.kr/" target="_blank" rel="noopener noreferrer" class="hover:text-gray-600 transition-colors">CMDSPACE_Class</a>
						<span class="mx-1">·</span>
						<a href="https://slashpage.com/cmds-class" target="_blank" rel="noopener noreferrer" class="hover:text-gray-600 transition-colors">CMDS_Materials</a>
					</p>
				</div>
			</div>
		</footer>
	</body>
</html>
