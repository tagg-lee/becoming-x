---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	tags: string[];
	uploaded_date: string;
	created_date: string;
}

const { title, description, tags, uploaded_date, created_date } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<article class="mx-auto max-w-3xl">
		<header class="mb-8">
			<a href="/" class="mb-4 inline-block text-sm text-gray-500 hover:text-gray-700">
				&larr; Back to dashboard
			</a>
			<h1 class="mb-2 text-3xl font-bold">{title}</h1>
			{description && <p class="mb-4 text-lg text-gray-600">{description}</p>}
			<div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
				<span>Uploaded: {uploaded_date}</span>
				<span>Created: {created_date}</span>
			</div>
			{tags.length > 0 && (
				<div class="mt-3 flex flex-wrap gap-2">
					{tags.map((tag) => (
						<span class="rounded-full bg-gray-200 px-3 py-1 text-xs font-medium text-gray-700">
							{tag}
						</span>
					))}
				</div>
			)}
		</header>
		<div class="prose prose-gray max-w-none">
			<slot />
		</div>
	</article>
</BaseLayout>
