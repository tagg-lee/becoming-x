---
interface Props {
	slug: string;
	title: string;
	description: string;
	tags: string[];
	uploaded_date: string;
	created_date: string;
	format: 'md' | 'html';
}

const { slug, title, description, tags, uploaded_date, created_date, format } = Astro.props;
---

<div
	class="content-card relative rounded-lg border border-gray-200 bg-white p-5 transition-shadow hover:shadow-md"
	data-title={title.toLowerCase()}
	data-description={description.toLowerCase()}
	data-tags={tags.join(',')}
	data-uploaded={uploaded_date}
	data-created={created_date}
>
	<a href={`/content/${slug}`} class="absolute inset-0 z-0" aria-label={title}></a>
	<div class="relative z-10 pointer-events-none">
		<div class="mb-2 flex items-center gap-2">
			<span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-mono text-gray-500">
				.{format}
			</span>
		</div>
		<h2 class="mb-1 text-lg font-semibold">{title}</h2>
		{description && <p class="mb-3 text-sm text-gray-500 line-clamp-2">{description}</p>}
		<div class="flex flex-wrap gap-1.5 pointer-events-auto">
			{tags.map((tag) => (
				<a
					href={`/tags/${tag}`}
					class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs text-gray-600 transition-colors hover:bg-gray-800 hover:text-white"
				>
					{tag}
				</a>
			))}
		</div>
		<div class="mt-3 text-xs text-gray-400">
			Uploaded {uploaded_date}
		</div>
	</div>
</div>
